<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Chohue.Desktop.Views.MessageBoxWindow"
        Title="Message"
        Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <StackPanel Margin="20" Spacing="16">
        <TextBlock x:Name="MessageText"
                   TextWrapping="Wrap"
                   MaxWidth="320" />

        <StackPanel x:Name="ButtonPanel"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="8">
            <Button x:Name="OkButton" Content="OK" MinWidth="80"
                    Click="OnOkClick" />
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="80"
                    Click="OnCancelClick" IsVisible="False" />
        </StackPanel>
    </StackPanel>
</Window>
