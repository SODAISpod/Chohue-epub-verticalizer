<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Chohue.ViewModels.ViewModels;assembly=Chohue.ViewModels"
        xmlns:res="clr-namespace:Chohue.Desktop.Resources"
        x:DataType="vm:SettingsViewModel"
        mc:Ignorable="d"
        x:Class="Chohue.Desktop.Views.SettingsWindow"
        Title="{x:Static res:Strings.SettingsTitle}"
        Width="480" Height="400"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <DockPanel Margin="16">

        <!-- Status message (bottom) -->
        <TextBlock DockPanel.Dock="Bottom"
                   Text="{Binding StatusMessage}"
                   Margin="0,8,0,0"
                   Foreground="Green"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <!-- Save / Cancel buttons -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8" Margin="0,12,0,0">
            <Button Content="{x:Static res:Strings.BtnSave}"
                    Command="{Binding SaveCommand}" />
            <Button Content="{x:Static res:Strings.BtnCancel}"
                    Click="OnCancelClick" />
        </StackPanel>

        <!-- Main content -->
        <StackPanel Spacing="12">

            <!-- External tools -->
            <HeaderedContentControl Header="{x:Static res:Strings.GroupExternalTools}">
                <Grid RowDefinitions="Auto,8,Auto,8,Auto"
                      ColumnDefinitions="120,*,Auto"
                      Margin="4">

                    <!-- Pandoc -->
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="{x:Static res:Strings.LblPandocPath}"
                               VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1"
                             Text="{Binding PandocPath}"
                             Margin="4,0" />
                    <Button Grid.Row="0" Grid.Column="2"
                            Content="{x:Static res:Strings.BtnBrowse}"
                            Click="OnBrowsePandocClick" />

                    <!-- Calibre -->
                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="{x:Static res:Strings.LblCalibrePath}"
                               VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1"
                             Text="{Binding CalibrePath}"
                             Margin="4,0" />
                    <Button Grid.Row="2" Grid.Column="2"
                            Content="{x:Static res:Strings.BtnBrowse}"
                            Click="OnBrowseCalibreClick" />

                    <!-- Kepubify -->
                    <TextBlock Grid.Row="4" Grid.Column="0"
                               Text="{x:Static res:Strings.LblKepubifyPath}"
                               VerticalAlignment="Center" />
                    <TextBox Grid.Row="4" Grid.Column="1"
                             Text="{Binding KepubifyPath}"
                             Margin="4,0" />
                    <Button Grid.Row="4" Grid.Column="2"
                            Content="{x:Static res:Strings.BtnBrowse}"
                            Click="OnBrowseKepubifyClick" />

                </Grid>
            </HeaderedContentControl>

            <!-- Image replacement -->
            <HeaderedContentControl Header="{x:Static res:Strings.GroupImage}">
                <StackPanel Spacing="6" Margin="4">
                    <CheckBox Content="{x:Static res:Strings.ChkUseBuiltinImage}"
                              IsChecked="{Binding UseBuiltinImage}" />
                    <Grid ColumnDefinitions="*,Auto"
                          IsEnabled="{Binding !UseBuiltinImage}">
                        <TextBox Grid.Column="0"
                                 Text="{Binding CustomImagePath}"
                                 IsReadOnly="True" />
                        <Button Grid.Column="1"
                                Content="{x:Static res:Strings.BtnBrowse}"
                                Margin="4,0,0,0"
                                Click="OnBrowseImageClick" />
                    </Grid>
                </StackPanel>
            </HeaderedContentControl>

        </StackPanel>
    </DockPanel>
</Window>
